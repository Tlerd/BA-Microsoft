{
  "description": "Checks a Markdown document marked with `style: ste80` or `ba_doc` each time it is saved.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/doc-lint.mjs",
              "--hook"
            ],
            "timeout": 20,
            "statusMessage": "Checking document..."
          }
        ]
      }
    ]
  }
}
